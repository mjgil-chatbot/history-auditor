#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
repo_hook="$repo_root/.githooks/pre-commit"

if [ -x "$repo_hook" ]; then
  exec "$repo_hook"
fi

if [ ! -f "$repo_root/Cargo.toml" ]; then
  exit 0
fi

echo "pre-commit: running cargo fmt --all"
cargo fmt --all --manifest-path "$repo_root/Cargo.toml"

if ! git diff --quiet -- '*.rs'; then
  echo "pre-commit: restaging formatted Rust files"
  git add --update -- '*.rs'
fi
